  {
    "id": "linear",
    "content": "如图，一次函数 y=2*x+1 的图像。",
    "figure_scene": {
      "pack": "math.function",
      "version": 1,
      "elements": [
        {
          "type": "axes",
          "id": "ax1",
          "x": {
            "min": -3,
            "max": 3,
            "tick_step": 1
          },
          "y": {
            "min": -3,
            "max": 5,
            "tick_step": 1
          },
          "grid": {
            "major": true
          }
        },
        {
          "type": "sampled_curve",
          "axes": "ax1",
          "expr": "2*x+1",
          "domain": {
            "min": -3,
            "max": 3
          },
          "samples": 128
        }
      ]
    },
    "expectOk": true
  },
