  "abilityBands": [
    {
      "id": "L1",
      "label": "入门",
      "maxNarrationCharsPerScene": 90,
      "maxScenes": 10,
      "maxTotalNarrationChars": 600,
      "maxDurationSec": 540,
      "forbiddenTerms": [
        "显然",
        "易得",
        "易知",
        "trivial",
        "不难看出",
        "同理可得"
      ],
      "requireLifeAnalogy": true,
      "pedagogySummary": "面向基础较弱的学生：短句、先生活再符号、一步一镜，允许多步拆解。"
    },
    {
      "id": "L2",
      "label": "巩固",
      "maxNarrationCharsPerScene": 120,
      "maxScenes": 10,
      "maxTotalNarrationChars": 720,
      "maxDurationSec": 600,
      "forbiddenTerms": [
        "显然",
        "trivial"
      ],
      "requireLifeAnalogy": false,
      "pedagogySummary": "面向多数学生：教材语为主，必要时一句类比，步骤完整。"
    },
    {
      "id": "L3",
      "label": "提升",
      "maxNarrationCharsPerScene": 100,
      "maxScenes": 8,
      "maxTotalNarrationChars": 560,
      "maxDurationSec": 420,
      "forbiddenTerms": [],
      "requireLifeAnalogy": false,
      "pedagogySummary": "面向学有余力：术语可直接使用，少铺垫，突出关键步骤与易错点。"
    }
  ],
