  "render": {
    "backend": "board_ffmpeg",
    "allowBackendFallback": false,
    "manimRuntime": "local",
    "ffmpegBinEnv": "MPG_EXPLAIN_FFMPEG_BIN",
    "piperBinEnv": "MPG_PIPER_BIN",
    "piperModelEnv": "MPG_PIPER_MODEL",
    "frameWidth": 1280,
    "frameHeight": 720,
    "fps": 1,
    "silencePadSec": 0.35,
    "ffmpegBinName": "ffmpeg",
    "ttsEngine": "say",
    "board": {
      "burnOnScreenText": true,
      "fontFileEnv": "MPG_EXPLAIN_BOARD_FONT",
      "fontFileCandidates": [
        "/System/Library/Fonts/Supplemental/Arial Unicode.ttf",
        "/System/Library/Fonts/Supplemental/Songti.ttc",
        "/Library/Fonts/Arial Unicode.ttf"
      ],
      "backgroundColor": "0x1a1a1a",
      "fontColor": "white",
      "fontSize": 40,
      "marginX": 72,
      "marginY": 72,
      "lineSpacing": 16,
      "maxCharsPerLine": 28,
      "maxLines": 14
    },
    "manimTemplates": {
      "sceneTemplateMap": {
        "read_stem": "read_stem",
        "idea": "idea",
        "step": "step",
        "answer": "answer",
        "pitfall": "pitfall",
        "summary": "summary"
      }
    },
    "manim": {
      "localBinEnv": "MPG_EXPLAIN_MANIM_BIN",
      "localBinName": "manim",
      "dockerBinEnv": "MPG_EXPLAIN_DOCKER_BIN",
      "dockerBinName": "docker",
      "dockerImage": "manimcommunity/manim:stable",
      "quality": "l",
      "scriptRelPath": "apps/web/manim-explain/render_explain_scenes.py",
      "sceneModuleName": "render_explain_scenes",
      "sceneClassName": "ExplainTemplateScene",
      "workdirMount": "/manim"
    }
  },
  "renderEnhance": {
    "enabled": true,
    "allowedTtsEngines": ["say", "piper"],
    "ttsEngineFallback": ["say", "piper"],
    "subtitles": {
      "enabled": true,
      "burnIn": true,
      "requireBurnIn": false,
      "maxCharsPerCue": 42,
      "maxLinesPerCue": 2
    },
    "synth": {
      "concatMaxAttempts": 2,
      "minOutputBytes": 1024,
      "minDurationSec": 0.5,
      "ffprobeBinEnv": "MPG_EXPLAIN_FFPROBE_BIN",
      "ffprobeBinName": "ffprobe"
    },
    "broll": {
      "enabled": false,
      "provider": "none",
      "allowedPurposes": ["idea", "summary"],
      "forbiddenPurposes": ["read_stem", "step", "answer", "pitfall"],
      "skipOnFailure": true
    }
  },
