  "handoutGeneration": {
    "mode": "ai",
    "temperature": 0.35,
    "maxTokens": 4096,
    "maxAttempts": 2,
    "systemPrompt": "你是中学讲义编写助手。只根据给定题干、标答与解析步骤编写分镜讲义与口播，不得编造与标答冲突的结论或数值。是否举例、是否展开公式说明，完全按本题与能力档教学要求决定，禁止套用固定口头禅或固定段落模板。输出且仅输出 JSON 对象。",
    "userPromptTemplate": "能力档：{{bandLabel}}\n教学要求：{{bandPedagogy}}\n分档补充说明：{{bandOverlay}}\n口播禁词（不得出现）：{{forbiddenTerms}}\n生活类比要求：{{analogyRequirement}}\n（单镜口播≤{{maxNarrationChars}}字，总分镜≤{{maxScenes}}，口播总字≤{{maxTotalNarrationChars}}，单镜默认时长约{{secondsPerSceneDefault}}秒）。\n允许的分镜目的（须按序列使用，step 可对每一步各一镜）：{{purposeSequence}}\n\n题干：\n{{stem}}\n\n标答：\n{{answer}}\n\n解析步骤（JSON）：\n{{stepsJson}}\n\n选择题选项（可能为空 JSON 数组）：\n{{optionsJson}}\n\n请输出 JSON：{\"scenes\":[{\"purpose\":\"...\",\"narration\":\"口播\",\"onScreen\":\"板书（可含公式 LaTeX）\",\"durationSec\":number}]}\n硬约束：scenes 非空；purpose 必须属于允许列表；narration/onScreen 非空；标答要点须在某镜出现；每条解析步骤的核心描述须被某镜覆盖；禁止输出 Markdown 围栏。\n务必：标答原文须完整出现在至少一镜的 onScreen；每条解析步骤 description 原文须出现在某镜 onScreen（可改述口播，但板书须保留原文要点）。口播可按能力档通俗改述，但不得改答案与步骤结论。",
    "requireAnswerCoverage": true,
    "requireStepCoverage": true,
    "lifeAnalogyMarkers": [
      "比如",
      "比方",
      "好像",
      "就像",
      "好比",
      "生活中",
      "打个比方",
      "可以想成"
    ],
    "bandOverlays": {
      "L1": "口播必须口语化、短句；至少一处生活类比帮助理解题意或算法；每步只讲一件事；避免「显然」「易得」等词。",
      "L2": "用清晰教材语讲解，步骤完整；类比可选，勿堆砌套话。",
      "L3": "突出关键推理与易错点，术语可直接使用，少做生活铺垫。"
    },
    "chatCompletionsExtras": {
      "thinking": { "type": "disabled" },
      "response_format": { "type": "json_object" }
    }
  },
