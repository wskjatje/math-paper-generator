{
  "version": 1,
  "paperKinds": [
    { "id": "regular_daily", "label": "日常考试 / 随堂测", "group": "regular" },
    { "id": "regular_unit", "label": "单元测试", "group": "regular" },
    { "id": "regular_final", "label": "期中 / 期末", "group": "regular" },
    { "id": "entrance_primary_junior", "label": "小升初", "group": "entrance" },
    { "id": "entrance_junior_senior", "label": "初升高", "group": "entrance" },
    { "id": "entrance_senior_college", "label": "高升大", "group": "entrance" },
    { "id": "contest_school", "label": "校内学科竞赛", "group": "contest" },
    { "id": "contest_city", "label": "市级学科竞赛", "group": "contest" },
    { "id": "contest_provincial", "label": "省级学科竞赛", "group": "contest" },
    { "id": "olympiad", "label": "奥林匹克竞赛（奥数 / 理科学科奥赛等综合）", "group": "contest" }
  ],
  "difficulties": [
    { "id": "beginner", "label": "入门" },
    { "id": "intermediate", "label": "进阶" },
    { "id": "competition", "label": "竞赛" },
    { "id": "advanced", "label": "高阶竞赛" }
  ],
  "importDefaults": {
    "duration_min": 100,
    "total_score": 120,
    "difficulty": "intermediate",
    "grade": "jhs_g3_s2",
    "subject": "math"
  },
  "generateDefaults": {
    "duration_min": 60,
    "total_score": 100,
    "difficulty": "intermediate"
  },
  "validation": {
    "duration_min": { "min": 30, "max": 360 },
    "total_score": { "min": 50, "max": 300 },
    "mcq": {
      "rejectDuplicateOptions": true,
      "dedupeOnPersist": true,
      "dedupeOnNormalize": false,
      "dedupeOnDisplay": true
    },
    "semanticGates": {
      "enabled": true,
      "alignment": {
        "enabled": true,
        "rules": [
          {
            "id": "primary_forbid_national_camp",
            "whenGradeBands": ["primary"],
            "forbidCorpusPatterns": [
              "国家集训队",
              "CMO",
              "IMO",
              "联赛二试",
              "联赛一试"
            ],
            "message": "年级学段与竞赛定位冲突：小学不宜绑定国家集训队/联赛一试二试/CMO·IMO 等标签"
          },
          {
            "id": "junior_forbid_imo_national",
            "whenGradeBands": ["junior"],
            "forbidCorpusPatterns": ["国家集训队", "IMO金牌", "IMO 金牌"],
            "message": "年级学段与竞赛定位冲突：初中不宜绑定国家集训队/IMO 金牌等标签"
          }
        ]
      },
      "solutionAnswerConflict": {
        "enabled": true,
        "rules": [
          {
            "id": "zero_methods_vs_positive",
            "solutionPatterns": [
              "没有放置方法",
              "无法放置",
              "0\\s*种",
              "零种",
              "无解",
              "没有满足",
              "无法满足"
            ],
            "answerConflictPatterns": [
              "^\\s*[1-9]",
              "^\\s*\\$\\s*[1-9]",
              "^\\s*[A-Da-d]\\s*$"
            ],
            "message": "解析断言无解/0 种，但答案为非零或选项字母"
          }
        ]
      },
      "countMcqSuspiciousOptions": {
        "enabled": true,
        "stemPatterns": [
          "有多少个",
          "有多少种",
          "共有多少",
          "一共有多少",
          "可能有多少",
          "共几种",
          "有几种",
          "共多少个",
          "共多少种"
        ],
        "optionTypes": ["multiple_choice", "multiple_choice_multi"],
        "requireAllOptionsNumeric": true,
        "maxOptionAbsValue": 9,
        "minOptionCount": 2,
        "message": "计数类选择题选项为过小整数序列，疑似未覆盖真实计数范围；请扩大选项区间或改为填空/解答"
      },
      "multiSelectAnswerLetters": {
        "enabled": true,
        "types": ["multiple_choice_multi"],
        "pluralStemPatterns": ["哪些", "下列正确", "正确的有", "所有正确", "全部正确"],
        "requireMultipleLettersWhenPluralStem": true,
        "messageInvalid": "多选题答案字母须对应已有选项",
        "messagePluralIncomplete": "题干要求选出多项时，答案须含至少两个正确选项字母"
      },
      "domainPlugins": {
        "enabled": true,
        "physicsWeightAsMassTrap": {
          "enabled": true,
          "stemPatterns": ["重力", "摩擦力", "加速度", "水平推力", "水平桌面"],
          "weightNewtonPattern": "(?:重力|重)\\s*(?:为|是)?\\s*\\$?\\s*(\\d+(?:\\.\\d+)?)\\s*(?:\\\\text\\{\\s*)?N",
          "frictionNewtonPattern": "摩擦(?:力)?\\s*(?:为|是)?\\s*\\$?\\s*(\\d+(?:\\.\\d+)?)\\s*(?:\\\\text\\{\\s*)?N",
          "accelPattern": "(?:加速度\\s*(?:为|是)?\\s*\\$?\\s*|以\\s*\\$?\\s*)(\\d+(?:\\.\\d+)?)\\s*(?:\\\\text\\{\\s*)?(?:m\\s*/\\s*s|米)",
          "gApprox": 10,
          "answerNewtonPattern": "(\\d+(?:\\.\\d+)?)\\s*(?:\\\\text\\{\\s*)?(?:N|牛)?",
          "toleranceAbs": 0.25,
          "message": "物理受力题答案疑似把重力数值当作质量使用（量纲错误）"
        },
        "solutionMassFraction": {
          "enabled": true,
          "stemPatterns": ["质量分数", "溶质"],
          "initialMassPercentPattern": "(\\d+(?:\\.\\d+)?)\\s*(?:\\\\text\\{\\s*)?(?:g|克)[^。；;]{0,80}?(?:质量分数|含有|含)[^0-9%]{0,24}(\\d+(?:\\.\\d+)?)\\s*\\\\?%",
          "addMassPattern": "(?:加入|加水|再加入|又加入)[^0-9]{0,16}(\\d+(?:\\.\\d+)?)\\s*(?:\\\\text\\{\\s*)?(?:g|克)",
          "evaporatePattern": "(?:蒸发|蒸去|蒸发掉)[^0-9]{0,16}(\\d+(?:\\.\\d+)?)\\s*(?:\\\\text\\{\\s*)?(?:g|克)",
          "answerPercentPattern": "(\\d+(?:\\.\\d+)?)\\s*\\\\?%",
          "toleranceAbs": 0.2,
          "message": "溶液质量分数与题干可推算值不一致"
        }
      }
    }
  },
  "qualityRemediation": {
    "actionIds": [
      "flag_needs_review",
      "exclude_from_assign",
      "clear_exclude_assign",
      "demote_mcq_to_fill",
      "strip_conflicting_track_tags",
      "regenerate_failing_questions"
    ],
    "actionLabels": {
      "flag_needs_review": "标为待修",
      "exclude_from_assign": "禁止布置",
      "clear_exclude_assign": "恢复可布置",
      "demote_mcq_to_fill": "计数选择题改填空",
      "strip_conflicting_track_tags": "去掉越阶竞赛标签",
      "regenerate_failing_questions": "修复问题题"
    },
    "issueActionHints": [
      {
        "issueCodePattern": "^alignment\\.",
        "suggestedActions": ["strip_conflicting_track_tags", "flag_needs_review"]
      },
      {
        "issueCodePattern": "count_option|mcq\\.count",
        "suggestedActions": ["demote_mcq_to_fill", "regenerate_failing_questions"]
      },
      {
        "issueCodePattern": "solution\\.answer|domain\\.|mcq\\.multi",
        "suggestedActions": ["regenerate_failing_questions"]
      },
      {
        "issueCodePattern": "^figure\\.|require_valid_figure|require_pure_json_figure",
        "suggestedActions": ["regenerate_failing_questions", "flag_needs_review"]
      }
    ],
    "stripTrackTagPatterns": [
      "国家集训队",
      "CMO",
      "IMO",
      "联赛一试",
      "联赛二试"
    ],
    "assignGate": {
      "requireStatuses": ["pass"],
      "blockWhenExcludeAssign": true,
      "passOverridesExcludeAssign": true,
      "clearExcludeAssignOnPass": true,
      "rejectMessage": "仅可布置已通过验证的试卷"
    },
    "validateLock": {
      "lockedStatuses": ["pass"],
      "rejectMessage": "已通过验证，不可再次验证"
    },
    "regenerate": {
      "maxQuestionsPerRun": 8,
      "systemExtra": "你正在修复已入库试卷中未通过语义校验的题目。必须保持题型与考查点，修正答案、解析与选项，使结论自洽且可通过数值/量纲验算。禁止猜测几何图；无法配图则不要依赖「如图」。",
      "userTemplate": "【试卷上下文】\n标题：{{examTitle}}\n标签：{{examTags}}\n\n【校验失败（必须全部消除）】\n{{issueBullets}}\n\n【已批准改进策略（须遵守）】\n{{learningHints}}\n\n【待修复原题 JSON】\n{{questionJson}}\n\n【强制】调用 submit_exam，questions 长度恰好为 1；保留合理题干事实，修正 answer / solution_steps / options；多选写全正确项；解析结论须与 answer 一致。",
      "recordedToLearningSuffix": "已记入设置 → 改进建议",
      "retryWithDefaultModelOnPatterns": [
        "Interactions API|与接口不兼容|only supports Interactions"
      ],
      "retryWithDefaultModelNote": "学科模型不兼容，已改用默认命题模型重试"
    },
    "learningFromValidate": {
      "enabled": true,
      "recordFailIssues": true,
      "injectHintsOnRegenerate": true
    },
    "displayHygieneOnValidate": {
      "enabled": true,
      "persistRepairs": true,
      "failOnUnhealed": false
    }
  },
  "generationLearning": {
    "autoAgree": {
      "enabled": true,
      "minEvidence": 3,
      "kinds": ["prompt_policy", "ops_advisory"],
      "actor": "auto-agree",
      "reevaluateOnRecord": true,
      "reevaluateOnRead": true
    },
    "runtimeIssueRules": [
      {
        "match": "Interactions API|与接口不兼容|only supports Interactions",
        "issueCode": "runtime.api_incompatible",
        "strategyId": "prefer_openai_compat_model",
        "kind": "ops_advisory",
        "summary": "模型接口与当前修题/命题调用不兼容"
      },
      {
        "match": "fetch failed|ECONNREFUSED|ENOTFOUND|无法连接|UND_ERR_CONNECT|ETIMEDOUT|socket hang up",
        "issueCode": "runtime.fetch_failed",
        "strategyId": "check_ai_endpoint_connectivity",
        "kind": "ops_advisory",
        "summary": "无法连接 AI 服务"
      }
    ]
  },
  "textNormalization": {
    "stripZeroWidth": true,
    "normalizeUnicodeSpaces": true,
    "fullwidthPunctToHalfwidthForCompare": true,
    "fullwidthPunctMap": {
      "，": ",",
      "。": ".",
      "：": ":",
      "；": ";",
      "！": "!",
      "？": "?",
      "（": "(",
      "）": ")",
      "【": "[",
      "】": "]",
      "＂": "\"",
      "＇": "'",
      "－": "-",
      "／": "/",
      "＝": "="
    },
    "applyUnicodeNoiseOnPersist": true,
    "applyUnicodeNoiseOnDisplay": true,
    "applyOnOptionDedupKey": true,
    "trimSpacedInlineMathDelimiters": true,
    "repairMalformedMhchemCe": true,
    "expandMhchemCeToPlainKatex": true,
    "unwrapFormulaLikeTextCommands": true,
    "wrapBareSubscriptAllowLeadingDigits": true,
    "mergeLetterParenInlineMath": true,
    "unwrapOverEscapedMarkdown": true,
    "normalizeEmptyMarkdownFences": true,
    "demoteEmbeddedDisplayMath": true,
    "demoteEmbeddedDisplayMathMaxInnerLength": 160,
    "collapseStemExtraBlankLines": true,
    "joinOrphanMathLines": true,
    "tightenStemBlankLines": true,
    "explicitMultiplyDisplay": "times",
    "latexTabEatenCommandRepairs": [
      { "eatenTail": "imes", "command": "times" },
      { "eatenTail": "ext", "command": "text", "requireOpenBrace": true },
      { "eatenTail": "extbf", "command": "textbf", "requireOpenBrace": true },
      { "eatenTail": "riangle", "command": "triangle" },
      { "eatenTail": "heta", "command": "theta" },
      { "eatenTail": "ightarrow", "command": "rightarrow" },
      { "eatenTail": "Rightarrow", "command": "Rightarrow" },
      { "eatenTail": "dots", "command": "ldots" }
    ],
    "bareLatexCommandRepairs": [
      { "bare": "leqslant", "command": "leqslant" },
      { "bare": "geqslant", "command": "geqslant" },
      { "bare": "cdots", "command": "cdots" },
      { "bare": "ldots", "command": "ldots" },
      { "bare": "approx", "command": "approx" },
      { "bare": "infty", "command": "infty" },
      { "bare": "triangle", "command": "triangle" },
      { "bare": "angle", "command": "angle" },
      { "bare": "cdot", "command": "cdot" },
      { "bare": "times", "command": "times" },
      { "bare": "leq", "command": "leq" },
      { "bare": "geq", "command": "geq" },
      { "bare": "neq", "command": "neq" },
      { "bare": "pm", "command": "pm" },
      { "bare": "mp", "command": "mp" },
      { "bare": "div", "command": "div" },
      { "bare": "sin", "command": "sin" },
      { "bare": "cos", "command": "cos" },
      { "bare": "tan", "command": "tan" },
      { "bare": "log", "command": "log" },
      { "bare": "ln", "command": "ln" },
      { "bare": "sqrt", "command": "sqrt", "requireOpenBrace": true },
      { "bare": "frac", "command": "frac", "requireOpenBrace": true },
      { "bare": "text", "command": "text", "requireOpenBrace": true }
    ],
    "numberedPlainEquationListToCases": {
      "enabled": true,
      "minEquations": 2,
      "maxEquations": 12,
      "triggerPatterns": [
        "解方程组",
        "解下列方程组",
        "下列方程组",
        "方程组\\s*[：:]",
        "solve\\s+the\\s+system",
        "system\\s+of\\s+equations"
      ],
      "equationLinePattern": "^\\s*(\\d+)\\s*[.、．)\\]］]\\s*(.+?=\\s*.+)$"
    },
    "promptLeakageStripPatterns": [
      "\\*\\*\\(\\s*e\\.g\\.[^)]*\\)\\*\\*",
      "\\(\\s*e\\.g\\.\\s*如图\\s*\\)",
      "\\(\\s*e\\.g\\.\\s*as\\s+shown[^)]*\\)"
    ],
    "normalizeLatexDelimitersToDollar": true,
    "normalizeMalformedMarkdownImages": true,
    "collapseNewlinesInsideMathDelimiters": true,
    "suppressNonTriangleDiagramWhenStemMentionsTriangle": true,
    "mcqAnswerBlankParenSpacing": {
      "enabled": true,
      "blankPatterns": ["（\\s*）", "\\(\\s*\\)"],
      "spaceBefore": " ",
      "innerFill": "　"
    }
  },
  "site": {
    "ogImageUrl": "https://pub-bb2e103a32db4e198524a2e9ed8f35b4.r2.dev/lovable-uploads/lovable.app-1777594590148.png"
  },
  "ai": {
    "gatewayUrl": "https://ai.gateway.lovable.dev/v1/chat/completions"
  },
  "choiceOptionsLayout": {
    "inlineMaxWeightPerOption": 12,
    "inlineMaxTotalWeight": 40,
    "columnsMaxWeightPerOption": 22,
    "columnsMaxTotalWeight": 80,
    "noBesideInlineMaxWeightPerOption": 14,
    "noBesideInlineMaxTotalWeight": 56,
    "noBesideColumnsMaxWeightPerOption": 28,
    "noBesideColumnsMaxTotalWeight": 100,
    "noBesideInlineDistribute": true,
    "noBesideInlineGapRem": 1.5,
    "noBesideInlineItemMinWidthRem": 0,
    "besideFigureMaxWeightPerOption": 24,
    "besideFigureMaxTotalWeight": 90,
    "besideFigureMinOptionCount": 2,
    "besideGapRem": 0.75,
    "stackedGapRem": 0.5,
    "inlineMathWeight": 6,
    "displayMathWeight": 12,
    "latinCharWeight": 0.55,
    "forceStackedIfDisplayMath": true,
    "forceStackedIfNewline": true
  },
  "examPaperSections": {
    "groupByConsecutiveType": true,
    "mergeAdjacentSameTypeSections": true,
    "chineseOrdinals": [
      "一", "二", "三", "四", "五", "六", "七", "八", "九", "十",
      "十一", "十二", "十三", "十四", "十五", "十六", "十七", "十八", "十九", "二十"
    ],
    "sectionTitleTemplate": "{{ordinal}}、{{typeLabel}}",
    "sectionMetaTemplate": "（共 {{count}} 小题，共 {{points}} 分）",
    "questionIndexTemplate": "{{n}}.",
    "questionPointsTemplate": "（{{points}}分）",
    "sectionHeaderShowBottomBorder": false,
    "stemPointsPlacement": {
      "withoutSubquestions": "inline_end",
      "withSubquestionsNoOwnPoints": "inline_end",
      "withSubquestionsOwnPoints": "omit"
    },
    "subquestionOwnPointsPatterns": [
      "[（(]\\s*\\d+\\s*分\\s*[）)]",
      "[（(]\\s*本小[题问]\\s*(?:满分)?\\s*\\d+\\s*分\\s*[）)]"
    ],
    "stripRedundantStemIndexPatterns": [
      "^\\s*(?:\\*\\*)?\\s*{{n}}\\s*[.．、]\\s*(?:\\*\\*)?",
      "^\\s*(?:\\*\\*)?\\s*第\\s*{{n}}\\s*题\\s*[.．、:：]?\\s*(?:\\*\\*)?"
    ]
  },
  "paperSurfaceLayout": {
    "subquestionLabelStyle": "fullwidth_paren",
    "subquestionLabelTemplate": "（{n}）",
    "stemToFigureGapRem": 0.5,
    "stemToSubquestionGapRem": 0.35,
    "stemShowBottomBorder": false,
    "stemMarkdownParagraphMarginRem": 0.3,
    "stemDisplayMathMarginRem": 0.2,
    "stemCodeBlockMarginRem": 0.15,
    "stemInlineCodeAppearance": "plain_mono",
    "stemLabeledSectionsEnabled": true,
    "stemLabeledSectionIndentRem": 1.5,
    "stemLabeledSectionLabelGapRem": 0.05,
    "stemLabeledSectionBlockGapRem": 0.25,
    "stemLabeledSectionLabelLinePattern": "^\\*\\*[^*\\n]+\\*\\*\\s*[:：]?\\s*$",
    "stemLabeledSectionPlainLabelLinePattern": "^[^\\n$*`]{1,24}[:：]\\s*$",
    "stemLabeledSectionBodyPaddingYRem": 0,
    "stemLabeledSectionBodyPaddingXRem": 0,
    "stemLabeledSectionBodySurface": false,
    "figureBlockCompactMarginRem": 0.35,
    "figureBlockMarginRem": 0.5,
    "eplBlockStackGapRem": 0.5,
    "subquestionClusterMarginRem": 0.35,
    "questionClusterMarginRem": 0.5,
    "attachmentStackGapRem": 0.5,
    "attachmentStackMarginRem": 0.5,
    "subquestionFigureBesideMaxWeightPerItem": 48,
    "subquestionFigureBesideMaxTotalWeight": 120,
    "subquestionFigureBesideMinCount": 1,
    "subquestionFigureBesideMaxCount": 6,
    "subquestionFigureBesideGapRem": 0.75,
    "subquestionFigureBesideFigureMaxWidthRem": 20,
    "subquestionFigureForceStackedIfDisplayMath": true,
    "subquestionFigureForceStackedIfMultiline": true,
    "subquestionIndentRem": 0,
    "numericParenElevateToSectionBodyPrefixes": ["将", "平移", "重叠"],
    "subquestionNoFigureLayout": "auto",
    "subquestionNoFigureInlineMaxWeightPerItem": 22,
    "subquestionNoFigureInlineMaxTotalWeight": 56,
    "subquestionNoFigureColumnsMaxWeightPerItem": 48,
    "subquestionNoFigureColumnsMaxTotalWeight": 120,
    "subquestionNoFigureForceStackedIfDisplayMath": true,
    "subquestionNoFigureForceStackedIfMultiline": true,
    "subquestionNoFigureStackIfWeightSpreadRatio": 1.35,
    "subquestionNoFigureMinCount": 2,
    "subquestionNoFigureMaxCount": 8,
    "listeningOmittedStemShowAuthoringPolicyBanner": false,
    "listeningOmittedStemShowAuthoringStemReveal": false,
    "listeningOmittedStemShowExamCue": false,
    "answerWritingSpace": {
      "enabled": true,
      "skipWhenHasChoiceOptions": true,
      "showBottomBorder": false,
      "excludeTypeIdPatterns": [
        "^multiple_choice",
        "^fill_blank$"
      ],
      "excludeTypeLabelPatterns": [
        "选择题",
        "^填空"
      ],
      "defaultMinHeightRem": 7,
      "rules": [
        {
          "typeIdPatterns": ["^proof$", "^essay$"],
          "typeLabelPatterns": ["证明", "作文", "写作", "论述", "申论"],
          "minHeightRem": 10
        },
        {
          "typeIdPatterns": ["^short_answer$", "^calculation$", "^cross_"],
          "typeLabelPatterns": ["解答", "计算", "简答", "应用题", "分析", "实验", "探究", "综合"],
          "minHeightRem": 8
        },
        {
          "typeIdPatterns": ["^programming$"],
          "typeLabelPatterns": ["编程", "程序设计", "代码"],
          "minHeightRem": 8
        }
      ]
    }
  },
  "listeningGeneration": {
    "questionDetectPatterns": [
      "听力",
      "听录音",
      "listening",
      "\\baudio\\b"
    ]
  },
  "figureGeneration": {
    "tryOptionalDiagramOnForce": true,
    "requireDiagramStemPatterns": [
      "如图|见图|见下图|如下图|按下图|下图所示|右图|左图|示意[图]?如下",
      "\\[图\\]|（图）|\\(图\\)"
    ],
    "optionalDiagramStemPatterns": [
      "\\\\triangle|△|三角形",
      "\\\\angle|∠",
      "直角三角形|Rt\\\\s*\\\\triangle",
      "圆|⊙|圆心|切线",
      "平行四边形|梯形|矩形|长方形|正方形",
      "坐标|数轴|函数图|图象|图像",
      "阴影|涂色|重叠部分",
      "网格|方格网|方格",
      "随机游走|random\\s*walk"
    ],
    "gridDimensionAliases": {
      "rowsKeys": ["rows", "row", "m", "nRows", "height"],
      "colsKeys": ["cols", "col", "columns", "n", "nCols", "width"],
      "pairKeys": ["size", "dims", "dimensions", "shape", "grid"],
      "pairPattern": "^(\\d+)\\s*(?:[x×X]|\\\\times)\\s*(\\d+)$",
      "stemSizePattern": "(\\d+)\\s*(?:\\\\times|×|x|X)\\s*(\\d+)",
      "stemGridMentionPattern": "方格|网格|方格网"
    },
    "sampleGridFigure": {
      "requirePatterns": ["网格|方格|方格网"],
      "sampleLeadPatterns": ["样例输入\\s*[:：]?", "Sample\\s*Input\\s*[:：]?"],
      "sampleEndPatterns": ["样例输出", "Sample\\s*Output", "输出格式"],
      "fenceCapturePatterns": ["```(?:[\\w+-]*)?\\r?\\n([\\s\\S]*?)```"],
